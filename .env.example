# Copy this file to .env.local (already gitignored) and fill in real values.
# Nothing here is required to run the site — every value has a static
# fallback in src/content/*.ts — these only enable the live data described
# in src/lib/social.ts.

# YouTube Data API v3 key. Powers the live channel avatar/banner/subscriber
# count on the Beyond Code page. Setup steps: see PROJECT_STATUS.md.
YOUTUBE_API_KEY=

# Resend (https://resend.com) API key. Powers the Contact form actually
# sending an email (src/lib/email.ts, src/app/api/contact/route.ts). Without
# it the form still works end-to-end but responds with a friendly
# "email isn't configured yet" error instead of sending anything.
RESEND_API_KEY=

# Optional — default to SITE.email / Resend's shared test sender if unset.
# CONTACT_FROM_EMAIL must be an address on a domain verified in Resend, e.g.
# "Portfolio <contact@yourdomain.com>" — until then, leave it unset and the
# test sender (onboarding@resend.dev) is used automatically.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
